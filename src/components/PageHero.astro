---
// The top of every inner page: eyebrow, title, one line, one illustration.
import Toran from "./Toran.astro";

interface Props {
  eyebrow: string;
  title: string;
  sub?: string;
  art?: string;
  artAlt?: string;
  color?: string;
  toran?: boolean;
}
const { eyebrow, title, sub, art, artAlt = "", color = "var(--marigold)", toran = false } = Astro.props;
---

<section class="page-hero" style={`--accent:${color}`}>
  {toran && <Toran />}
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow reveal"><span class="dot"></span>{eyebrow}</p>
      <h1 class="reveal" set:html={title} />
      {sub && <p class="sub reveal">{sub}</p>}
      <div class="reveal"><slot /></div>
    </div>
    {art && (
      <div class="art-wrap">
        <div class="blob" aria-hidden="true"></div>
        <img class="art float" src={`/art/${art}.svg`} alt={artAlt} fetchpriority="high" />
      </div>
    )}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(40% 55% at 12% 30%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 70%),
      radial-gradient(35% 45% at 88% 25%, color-mix(in srgb, var(--mango) 25%, transparent), transparent 70%);
  }
  .grid {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding-top: clamp(1.5rem, 4vw, 3rem);
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-play);
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--paper-raised);
    border: 3px solid var(--line);
    border-radius: 999px;
    padding: 0.25rem 0.9rem;
    box-shadow: 0 3px 0 var(--line);
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--line);
  }
  h1 {
    margin-top: 1.1rem;
    font-size: clamp(2.3rem, 6.5vw, 4.2rem);
    font-weight: 800;
    color: var(--shyam);
  }
  .sub {
    margin-top: 1rem;
    font-size: clamp(1.08rem, 2vw, 1.25rem);
    color: var(--ink-soft);
    max-width: 36rem;
  }
  .art-wrap {
    position: relative;
    max-width: 440px;
    width: 100%;
    margin: 0 auto;
  }
  .blob {
    position: absolute;
    inset: 4%;
    background: var(--paper-raised);
    border: 3px solid var(--line);
    border-radius: 58% 42% 46% 54% / 48% 56% 44% 52%;
    box-shadow: 8px 8px 0 var(--line);
  }
  .art-wrap img {
    position: relative;
    width: 100%;
    height: auto;
    padding: 10%;
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }
</style>
