---

<button class="theme-toggle" type="button" aria-label="Switch to night theme">
  <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="5" /><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1" /></svg>
  <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" /></svg>
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const root = document.documentElement;
  const label = () => {
    const night = root.dataset.theme === "dark";
    btn?.setAttribute("aria-label", night ? "Switch to day theme" : "Switch to night theme");
  };
  label();
  btn?.addEventListener("click", () => {
    root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
    try { localStorage.setItem("saru-theme", root.dataset.theme); } catch {}
    label();
  });
</script>

<style>
  .theme-toggle {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 3px solid var(--line);
    border-radius: 50%;
    background: var(--paper-raised);
    color: var(--ink);
    box-shadow: 0 3px 0 var(--line);
    cursor: pointer;
  }
  .theme-toggle svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .theme-toggle .sun circle { fill: var(--mango); }
  .theme-toggle .moon { display: none; fill: var(--mango); }
  :global([data-theme="dark"]) .theme-toggle .sun { display: none; }
  :global([data-theme="dark"]) .theme-toggle .moon { display: block; }
</style>
