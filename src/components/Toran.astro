---
// Marigold toran — strung across the top of the hero like a doorway on a
// festival morning. Pure SVG pattern, so it repeats at any width.
---

<svg class="toran" aria-hidden="true" width="100%" height="64">
  <defs>
    <pattern id="toran-unit" width="72" height="64" patternUnits="userSpaceOnUse">
      <path d="M0 8 Q36 26 72 8" fill="none" stroke="#1d1b2f" stroke-width="3" />
      <path d="M36 17 L36 30" stroke="#1d1b2f" stroke-width="2.5" />
      <g transform="translate(36 38)">
        <circle r="11" fill="#ff9f1c" stroke="#1d1b2f" stroke-width="3" />
        <circle r="6.5" fill="#ffb84d" />
        <circle r="3.5" fill="#ffd23f" />
      </g>
      <path d="M8 11 Q2 26 12 34 Q18 22 8 11Z" fill="#3bb273" stroke="#1d1b2f" stroke-width="2.5" />
      <path d="M64 11 Q70 26 60 34 Q54 22 64 11Z" fill="#2e8b57" stroke="#1d1b2f" stroke-width="2.5" />
    </pattern>
  </defs>
  <rect width="100%" height="64" fill="url(#toran-unit)" />
</svg>

<style>
  .toran {
    display: block;
    transform-origin: top center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .toran {
      animation: sway 6s ease-in-out infinite;
    }
    @keyframes sway {
      0%, 100% { transform: rotate(0deg); }
      50% { transform: rotate(0.25deg) translateY(1px); }
    }
  }
</style>
