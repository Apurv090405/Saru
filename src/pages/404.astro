---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Lost in the forest — Saru Charitable Trust">
  <section class="section">
    <div class="wrap lost">
      <img class="art float" src="/art/kanha-lost.svg" alt="Little Kanha peeking out from behind bushes in a forest" />
      <p class="code">404</p>
      <h1>Kanha wandered into the forest…</h1>
      <p>This page isn't here. Let's go home together.</p>
      <div class="actions">
        <a class="btn btn--give" href="/">Take me home</a>
        <a class="btn btn--ghost" href="/drives/">See drives</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lost { text-align: center; max-width: 36rem; }
  .lost img { width: min(380px, 90%); margin: 0 auto; }
  .code { font-family: var(--font-play); font-weight: 800; font-size: 1.2rem; color: var(--marigold); margin-top: 1rem; }
  h1 { font-size: clamp(2rem, 6vw, 3rem); font-weight: 800; color: var(--shyam); }
  .lost > p:not(.code) { color: var(--ink-soft); margin-top: 0.6rem; }
  .actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.6rem; }
</style>
