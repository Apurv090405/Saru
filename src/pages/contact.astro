---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Wave from "../components/Wave.astro";
import { contact } from "../data/site.js";

const topics = ["Volunteering", "Visit a drive", "Partner with us", "Donate books or supplies", "Something else"];
---

<BaseLayout title="Contact — Saru Charitable Trust" description="Write to Saru Charitable Trust in Ahmedabad.">
  <PageHero
    eyebrow="Contact"
    title="Say <span class='crayon'>namaste</span>"
    sub="Questions, ideas, or just want to visit a drive? Write to us. We read every message."
    art="letter-pen"
    artAlt="An envelope with a heart and a pen"
    color="var(--marigold)"
  />

  <Wave from="var(--paper)" to="var(--wash-mango)" />
  <section class="section section--mango">
    <div class="wrap two">
      <div class="ways reveal">
        <a class="sticker way" href={`mailto:${contact.email}`}>
          <span class="icon" aria-hidden="true">✉️</span>
          <span><strong>Email</strong>{contact.email}</span>
        </a>
        <div class="sticker way">
          <span class="icon" aria-hidden="true">📍</span>
          <span><strong>Where</strong>{contact.city}</span>
        </div>
        <div class="sticker way">
          <span class="icon" aria-hidden="true">🕊️</span>
          <span><strong>Drives</strong>Most Sundays. <a href="/drives/">See the calendar →</a></span>
        </div>
        <img class="art ways-art float" src="/art/gauri-nandu.svg" alt="Gauri the cow and Nandu the calf, resting" loading="lazy" />
      </div>

      <!-- No backend: submit opens the visitor's email app, pre-filled. -->
      <form class="sticker form reveal" id="contact-form" style="transform:none" novalidate>
        <h2>Write to us</h2>
        <label>Your name<input name="name" required autocomplete="name" /></label>
        <label>Your email or phone<input name="reply" required /></label>
        <label>About
          <select name="topic">{topics.map((t) => <option>{t}</option>)}</select>
        </label>
        <label>Message<textarea name="message" rows="5" required></textarea></label>
        <p class="error" role="alert" hidden>Please fill in your name, how to reach you, and a message.</p>
        <button type="submit" class="btn btn--give">Send message</button>
        <p class="hint">Sending opens your email app with your message ready to go.</p>
      </form>
    </div>
  </section>
  <Wave from="var(--wash-mango)" to="var(--footer)" flip />
</BaseLayout>

<script define:vars={{ email: contact.email }}>
  const form = document.getElementById("contact-form");
  const error = form.querySelector(".error");
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { error.hidden = false; return; }
    error.hidden = true;
    const f = new FormData(form);
    const body = `${f.get("message")}\n\n— ${f.get("name")} (${f.get("reply")})`;
    location.href = `mailto:${email}?subject=${encodeURIComponent(`${f.get("topic")} — ${f.get("name")}`)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .two { display: grid; gap: 2rem; align-items: start; }
  .ways { display: grid; gap: 1rem; }
  .way { display: flex; align-items: center; gap: 1rem; padding: 1rem 1.2rem; text-decoration: none; }
  .way span:last-child { display: grid; overflow-wrap: anywhere; }
  .icon { font-size: 1.8rem; }
  .ways-art { width: min(280px, 80%); margin: 1rem auto 0; }
  .form { padding: clamp(1.2rem, 4vw, 2rem); display: grid; gap: 1rem; }
  h2 { font-size: 2rem; font-weight: 800; color: var(--shyam); }
  label { display: grid; gap: 0.3rem; font-weight: 800; }
  input, select, textarea { font: inherit; font-weight: 400; min-height: 48px; padding: 0.6rem 0.9rem; color: var(--ink); background: var(--paper); border: 3px solid var(--line); border-radius: 14px; }
  .error { font-weight: 800; color: var(--kumkum); }
  :global([data-theme="dark"]) .error { color: var(--lotus); }
  .hint { font-size: 0.85rem; color: var(--ink-soft); }
  .form .btn { justify-self: start; }
  @media (min-width: 900px) { .two { grid-template-columns: 0.9fr 1.1fr; } }
</style>
